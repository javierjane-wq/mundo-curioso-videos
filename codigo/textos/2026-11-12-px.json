{
  "etiqueta": "¿LO SABÍAS?",
  "textos": [
    {"inicio": 0,    "fin": 2.5,  "lineas": ["Este lagarto tiene", "un *superpoder*…"]},
    {"inicio": 2.5,  "fin": 5.0,  "lineas": ["Si le *amenazan*,", "salta al río…"]},
    {"inicio": 5.0,  "fin": 7.5,  "lineas": ["…y *CORRE* sobre", "el agua", "a dos patas"]},
    {"inicio": 7.5,  "fin": 10.1, "lineas": ["*4,5 m*"], "estilo": "grande"},
    {"inicio": 7.7,  "fin": 8.9,  "lineas": ["sobre el agua", "sin *hundirse*"], "posicion": "debajo"},
    {"inicio": 8.9,  "fin": 10.1, "lineas": ["Sus pies crean", "*bolsas de aire*"], "posicion": "debajo"}
  ]
}
