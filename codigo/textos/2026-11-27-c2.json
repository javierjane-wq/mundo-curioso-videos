{
  "etiqueta": "¿LO SABÍAS?",
  "textos": [
    {"inicio": 0,    "fin": 2.4,  "lineas": ["El cactus *SAGUARO*", "vive en el desierto"], "voz": "Este es el cactus saguaro, un gigante del desierto."},
    {"inicio": 2.4,  "fin": 4.9,  "lineas": ["Allí casi nunca", "*llueve*…"], "voz": "Allí casi nunca llueve."},
    {"inicio": 4.9,  "fin": 7.0,  "lineas": ["…pero cuando llueve,", "*bebe* sin parar"], "voz": "Pero cuando llueve, bebe sin parar."},
    {"inicio": 7.0,  "fin": 10.1, "lineas": ["*¡SE HINCHA!*"], "estilo": "grande", "voz": "¡Se hincha!"},
    {"inicio": 7.2,  "fin": 10.1, "lineas": ["Sus pliegues se abren", "como un *acordeón*"], "posicion": "debajo"}
