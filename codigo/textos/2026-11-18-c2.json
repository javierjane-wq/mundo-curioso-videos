{
  "etiqueta": "¿LO SABÍAS?",
  "textos": [
    {"inicio": 0,    "fin": 2.5,  "lineas": ["¿Te enseñaron el", "*mapa* de la lengua?"]},
    {"inicio": 2.5,  "fin": 5.0,  "lineas": ["Dulce en la punta,", "*amargo* al fondo…"]},
    {"inicio": 5.0,  "fin": 7.4,  "lineas": ["…pero ese mapa", "*no es verdad*"]},
    {"inicio": 7.4,  "fin": 10.1, "lineas": ["*MITO*"], "estilo": "grande"},
    {"inicio": 7.6,  "fin": 10.1, "lineas": ["Toda la lengua nota", "*todos* los sabores"], "posicion": "debajo"}
  ]
}
